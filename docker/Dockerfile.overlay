# Overlay image: the files this branch changes, on top of the live image.
# Stacked overlay DGX-1900 (chat side panel redesign): base = fork-d923a5e-p3a96b32 (the live tag
# of the chart: upstream v0.22.2 + the python overlays of this branch, last one DGX-1621).
# What changes here is the dashboard, so this overlay carries the BUILT frontend: `web/` of this
# branch (the panel redesign, main PR #37) rebuilt with the repo's own recipe — node-deps.mjs for
# the workspace deps, generate_icons.py for the icon set, scripts/build/web.mjs for the bundle —
# and only the resulting dist lands in the runtime layer. The Node dependencies of the build stage
# never enter the final image, same as upstream's Dockerfile (frontend deps are not runtime deps).
# DGX-1928: the branch also carries python fixes (#39/#41, audio→Telegram voice bubble) that the
# dashboard-only overlay silently dropped — every file the branch changes over the base is copied
# explicitly here; adding one to the branch means adding it below.
ARG BASE=harbor.lan.e-dani.com/homelab/hermes-agent:fork-d923a5e-p3a96b32

FROM ${BASE} AS dashboard_build
USER root
WORKDIR /opt/hermes
# The branch's frontend source over the base's (the base carries the deploy line's web/ byte for
# byte, so this only adds the redesign). Deps and build tools are already in the base image.
COPY web/ web/
RUN node scripts/build/node-deps.mjs --source /opt/hermes --workspace web \
 && /opt/hermes/.venv/bin/python -I scripts/generate_icons.py --source /opt/hermes --out /tmp/hermes-icons \
 && node scripts/build/web.mjs --source /opt/hermes --icons /tmp/hermes-icons --out /opt/products/web

FROM ${BASE}
COPY --from=dashboard_build /opt/products/web /opt/hermes/hermes_cli/web_dist
# Voice-bubble fixes (#39 forward is_voice to send_voice, #41 transcode before direct-bot send).
COPY tools/send_message_tool.py tools/send_message_senders.py tools/
