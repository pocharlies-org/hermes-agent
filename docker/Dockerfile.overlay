# Overlay image: the files this branch changes, on top of the live image.
# Stacked overlay DGX-1471: base = fork-d923a5e-p3a0d745 (the live tag of the chart, itself
# upstream v0.22.2 + the 12-file overlay of this branch: reasoning picker PR #119110, DGX-578,
# INFRA-776, INFRA-697, DGX-791, INFRA-439). Only the files DGX-1471 changes are COPYed here:
# - DGX-1471 (barrera DGX-698): tools/environments/local.py y local_env_policy.py —
#   ALARMA_HMAC_SECRET es Tier-1 y _filter_secret_env la aplica ahora en AMBOS caminos
#   (_make_run_env del terminal en primer plano y _sanitize_subprocess_env).
# Before building a new stack, verify these two files in the BASE answer to the shas of this
# branch at the fork point (the COPY overwrites without looking).
ARG BASE=harbor.lan.e-dani.com/homelab/hermes-agent:fork-d923a5e-p3a0d745
FROM ${BASE}
COPY --chmod=644 tools/environments/local.py /opt/hermes/tools/environments/local.py
COPY --chmod=644 tools/environments/local_env_policy.py /opt/hermes/tools/environments/local_env_policy.py
