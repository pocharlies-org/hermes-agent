# Overlay image: the files this branch changes, on top of the live image.
# DGX-1963: stage2-hook re-chownea los ficheros de estado de arranque bajo
# installs/*/ en cada boot — un .recovery.lock root-owned (escritor uid 0 sobre el
# PVC compartido) tumbaba el arranque supervisado (uid 10000) con PermissionError
# en _claim_recovery_lock y el gateway entraba en crash-loop sin curarse con
# ningún restart (DEPL-21362, pin DGX-1948). El bloque va byte a byte como el de
# main (PR #45); el resto de la línea de deploy queda como los bytes de la base.
ARG BASE=harbor.lan.e-dani.com/homelab/hermes-agent:fork-d923a5e-p2b47af46
FROM ${BASE}
COPY --chmod=755 docker/stage2-hook.sh /etc/cont-init.d/01-hermes-setup
